generator client {
  provider      = "prisma-client-js"
  output        = "../../../generated/profissionais"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum PapelTecnico {
  DIRETOR
  DIRETOR_FOTOGRAFIA
  SONOPLASTA
  EDITOR
  ROTEIRISTA
  EFEITOS_VISUAIS
}

model Profissional {
  id                String            @id @default(uuid()) @db.Uuid
  nome              String
  email             String            @unique
  especialidades    PapelTecnico[]
  precoMin          Decimal           @db.Decimal(12, 2)
  precoMax          Decimal           @db.Decimal(12, 2)
  localizacao       String
  historicoProjetos String[]
  competencias      Competencia[]
  avaliacoes        Avaliacao[]
  disponibilidades  Disponibilidade[]

  @@index([especialidades], type: Gin)
  @@index([precoMin])
}

model Disponibilidade {
  id             String       @id @default(uuid()) @db.Uuid
  profissionalId String       @db.Uuid
  inicio         DateTime
  fim            DateTime
  profissional   Profissional @relation(fields: [profissionalId], references: [id], onDelete: Cascade)

  @@index([profissionalId, inicio, fim])
}

model Competencia {
  id             String       @id @default(uuid()) @db.Uuid
  profissionalId String       @db.Uuid
  nome           String
  nivel          Float
  profissional   Profissional @relation(fields: [profissionalId], references: [id], onDelete: Cascade)

  @@unique([profissionalId, nome])
}

model Avaliacao {
  id             String       @id @default(uuid()) @db.Uuid
  profissionalId String       @db.Uuid
  autorId        String
  projetoId      String?
  nota           Int
  comentario     String?
  criadaEm       DateTime     @default(now())
  profissional   Profissional @relation(fields: [profissionalId], references: [id], onDelete: Cascade)

  @@index([profissionalId])
  @@index([autorId])
}
